{
  "extends": "@velar/config/tsconfig/react-library.json",
  "compilerOptions": {
    /*
     * ESM, no CommonJS: the base config uses `module: esnext`. A CJS emit would
     * prepend "use strict" before the 'use client' directive and Next would stop
     * recognizing the client boundary, which requires the directive to be the
     * file's first statement.
     */
    "outDir": "./dist"
  },
  "include": ["src"]
}
